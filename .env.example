# ---- Pflicht (Werte erzeugen z. B. mit: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
ACCESS_CODE=bitte-aendern            # Zugangscode für Nutzer (am Drucker aushängen, regelmäßig wechseln)
ADMIN_PASSWORD=bitte-aendern-lang    # Passwort für /admin
AGENT_TOKEN=                         # mind. 24 Zeichen, identisch in agent/config.toml
SECRET_KEY=                          # mind. 32 Zeichen, signiert die Session-Cookies

# ---- Optional
SITE_TITLE=Druckdienst Arbeitsraum
MAX_UPLOAD_MB=50
MAX_PAGES=300                        # max. Seiten pro PDF
MAX_COPIES=20
RATE_LIMIT_JOBS_PER_HOUR=20          # pro IP / Name / Sitzung
MAX_PAGES_PER_DAY=0                  # Druckseiten pro Nutzer in 24 h, 0 = unbegrenzt
JOB_EXPIRE_HOURS=12                  # nicht abgeholte Aufträge danach verwerfen
PRINTING_TIMEOUT_MIN=15              # 'Wird gedruckt' ohne Rückmeldung -> Fehler
LOG_RETENTION_DAYS=365
FORMATS=A4,A3
DUPLEX_FORMATS=A4,A3              # Formate, für die Duplex angeboten wird (am Gerät prüfen!)
COOKIE_SECURE=true                   # lokal ohne HTTPS: false
